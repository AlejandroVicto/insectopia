meta {
  name: 18 - Ocultar conversación
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/conversaciones/{{conversacionId}}/ocultar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:pre-request {
  if (bru.getEnvName() !== "Local" || !/^http:\/\/(localhost|127\.0\.0\.1)(:\d+)?$/.test(bru.getEnvVar("baseUrl"))) {
    throw new Error("Solo se permiten pruebas de escritura/login en Local (localhost).");
  }
}

tests {
  test("La operación devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
