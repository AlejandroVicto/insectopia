meta {
  name: 18 - Ocultar conversación
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/api/conversaciones/{{conversacionId}}/ocultar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("conversacionDemoId") ||
      bru.getVar("conversacionId") !== bru.getVar("conversacionDemoId")) {
    throw new Error("Ejecute primero 16: solo se oculta la conversación demo.");
  }
}

tests {
  test("La operación devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
