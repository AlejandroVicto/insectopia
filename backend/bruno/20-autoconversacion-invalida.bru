meta {
  name: 066 - Autoconversación inválida (400)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/conversaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "destinatarioId": {{yoId}}
  }
}
