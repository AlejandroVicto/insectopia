meta {
  name: 12 - Quitar reacción
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/publicaciones/{{publicacionId}}/reaccion
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("publicacionPropiaId") ||
      bru.getVar("publicacionId") !== bru.getVar("publicacionPropiaId")) {
    throw new Error("Ejecute 07 y 11 antes: solo se quita la reacción propia de prueba.");
  }
}

tests {
  test("La operación devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
