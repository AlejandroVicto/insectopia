meta {
  name: 20 - Recuperar conversación oculta
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/conversaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "destinatarioId": {{seguidoId}}
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    const id = body && body.id;
    if (Number.isSafeInteger(id) && id > 0) {
      bru.setVar("conversacionId", id);
      bru.setVar("conversacionDemoId", id);
    }
  }
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("seguidoId") || !bru.getVar("conversacionDemoId") ||
      bru.getVar("conversacionId") !== bru.getVar("conversacionDemoId")) {
    throw new Error("Ejecute 16 y 18 antes: solo se recupera la conversación demo.");
  }
}

tests {
  test("Una conversación existente devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
