meta {
  name: 21 - Consultar historial de mensajes
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/api/conversaciones/{{conversacionId}}/mensajes?page=0&size=30
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("La consulta devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("content").that.is.an("array");
  });
}
