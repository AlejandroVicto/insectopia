meta {
  name: 066 - Recuperar/reutilizar conversación (200)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/conversaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "destinatarioId": {{seguidoId}}
  }
}
