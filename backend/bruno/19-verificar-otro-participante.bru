meta {
  name: 19 - Verificar otro participante
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/conversaciones?page=0&size=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenInterlocutor}}
}

headers {
  Accept: application/json
}

tests {
  test("La consulta devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("content").that.is.an("array");
  });
}
