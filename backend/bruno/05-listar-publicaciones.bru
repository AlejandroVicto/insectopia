meta {
  name: 05 - Listar publicaciones
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/publicaciones?page=0&size=10&feed=global
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    const id = body && Array.isArray(body.content) && body.content[0] && body.content[0].id;
    if (Number.isSafeInteger(id) && id > 0) bru.setVar("publicacionId", id);
    else bru.deleteVar("publicacionId");
  }
}

tests {
  test("El feed devuelve una página HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("content").that.is.an("array");
  });
}
