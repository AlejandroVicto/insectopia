meta {
  name: 11 - Registrar reacción
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/publicaciones/{{publicacionId}}/reaccion
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("publicacionPropiaId") ||
      bru.getVar("publicacionId") !== bru.getVar("publicacionPropiaId")) {
    throw new Error("Ejecute 07 antes: solo se reacciona a la publicación propia de prueba.");
  }
}

tests {
  test("La primera reacción devuelve 200; repetirla devuelve 409", function () {
    expect([200, 409]).to.include(res.getStatus());
    if (res.getStatus() === 409) {
      expect(res.getBody().details.some(detail => detail.field === "publicacionId")).to.equal(true);
    }
  });
}
