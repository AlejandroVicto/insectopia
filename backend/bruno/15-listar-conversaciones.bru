meta {
  name: 15 - Listar conversaciones
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/conversaciones?page=0&size=50&q=&noLeidos=false
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    const conversacion = body && Array.isArray(body.content) &&
      body.content.find(item => item.interlocutor && item.interlocutor.id === bru.getVar("seguidoId") &&
        /^demo\./.test(item.interlocutor.nombreUsuario || ""));
    if (conversacion && Number.isSafeInteger(conversacion.id) && conversacion.id > 0) {
      bru.setVar("conversacionId", conversacion.id);
      bru.setVar("conversacionDemoId", conversacion.id);
    } else {
      bru.deleteVar("conversacionId");
      bru.deleteVar("conversacionDemoId");
    }
  }
}

tests {
  test("La consulta devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("content").that.is.an("array");
  });
}
