meta {
  name: Crear publicación autenticada
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/publicaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
