meta {
  name: 09 - Crear comentario
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/publicaciones/{{publicacionId}}/comentarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "contenido": "[BRUNO-VPS-PRUEBA] Comentario de una cuenta demo"
  }
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("publicacionPropiaId") ||
      bru.getVar("publicacionId") !== bru.getVar("publicacionPropiaId")) {
    throw new Error("Ejecute 07 antes: solo se comenta la publicación propia de prueba.");
  }
}

tests {
  test("La creación devuelve HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property("id");
  });
}
