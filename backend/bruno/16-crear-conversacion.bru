meta {
  name: 16 - Crear conversación directa
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/conversaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "destinatarioId": {{seguidoId}}
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    const id = body && body.id;
    if (Number.isSafeInteger(id) && id > 0) {
      bru.setVar("conversacionId", id);
      bru.setVar("conversacionDemoId", id);
    }
  }
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("seguidoId")) {
    throw new Error("Ejecute 01 con una cuenta demo y 13 con un seguido demo antes de crear la conversación.");
  }
}

tests {
  test("Crear devuelve 201; si ya existía, reutilizar devuelve 200", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.getBody()).to.have.property("id");
  });
}
