meta {
  name: 064 - Sin JWT se rechaza con 401
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/conversaciones?page=0&size=20
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Una petición protegida sin JWT devuelve HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
