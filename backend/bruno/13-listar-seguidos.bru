meta {
  name: 13 - Listar usuarios seguidos
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/usuarios/seguidos?page=0&size=50
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    const seguido = body && Array.isArray(body.content) &&
      body.content.find(usuario => /^demo\./.test(usuario.nombreUsuario || ""));
    if (seguido && Number.isSafeInteger(seguido.id) && seguido.id > 0) bru.setVar("seguidoId", seguido.id);
    else bru.deleteVar("seguidoId");
  }
}

tests {
  test("La consulta devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("content").that.is.an("array");
  });
}
