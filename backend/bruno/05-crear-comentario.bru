meta {
  name: Crear comentario con autor del JWT
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/publicaciones/1/comentarios
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "contenido": "Comentario de verificación de la actividad 060"
  }
}
