meta {
  name: 14 - Buscar usuarios seguidos
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/usuarios/seguidos?page=0&size=20&q=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("La consulta devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("content").that.is.an("array");
  });
}
