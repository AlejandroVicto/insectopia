meta {
  name: 22 - Enviar mensaje
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/conversaciones/{{conversacionId}}/mensajes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "contenido": "[BRUNO-VPS-PRUEBA] Mensaje de prueba para una cuenta demo"
  }
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true || !bru.getVar("conversacionDemoId") ||
      bru.getVar("conversacionId") !== bru.getVar("conversacionDemoId")) {
    throw new Error("Ejecute primero 16: solo se envían mensajes a la conversación demo.");
  }
}

tests {
  test("La creación devuelve HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property("id");
  });
}
