meta {
  name: 22 - Enviar mensaje
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/conversaciones/{{conversacionId}}/mensajes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "contenido": "[BRUNO-LOCAL] Mensaje de prueba 064"
  }
}

script:pre-request {
  if (bru.getEnvName() !== "Local" || !/^http:\/\/(localhost|127\.0\.0\.1)(:\d+)?$/.test(bru.getEnvVar("baseUrl"))) {
    throw new Error("Solo se permiten pruebas de escritura/login en Local (localhost).");
  }
}

tests {
  test("La creación devuelve HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property("id");
  });
}
