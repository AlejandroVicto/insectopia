meta {
  name: 07 - Crear publicación
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/publicaciones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "contenido": "[BRUNO-VPS-PRUEBA] Observación de campo de una cuenta demo",
    "imagen": null
  }
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 201) {
    const body = res.getBody();
    const id = body && body.id;
    if (Number.isSafeInteger(id) && id > 0) {
      bru.setVar("publicacionId", id);
      bru.setVar("publicacionPropiaId", id);
    }
  }
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  if (bru.getVar("cuentaDemo") !== true) throw new Error("Las escrituras exigen una cuenta demo; ejecute 01 con una cuenta demo autorizada.");
}

tests {
  test("La creación devuelve HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property("id");
  });
}
