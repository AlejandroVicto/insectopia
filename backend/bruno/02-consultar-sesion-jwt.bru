meta {
  name: 02 - Consultar sesión utilizando JWT
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

script:pre-request {
  if (!bru.getVar("token")) throw new Error("Falta el JWT: ejecute primero 01-login-jwt.bru en Produccion.");
  req.setHeader("Authorization", "Bearer " + bru.getVar("token"));
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && Number.isSafeInteger(body.id)) bru.setVar("yoId", body.id);
  }
}

tests {
  test("El JWT permite consultar /api/auth/me", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("La API devuelve el usuario autenticado", function () {
    const body = res.getBody();
    expect(body).to.have.property("id");
    expect(body).to.have.property("email").that.is.a("string");
    expect(body).to.have.property("role").that.is.a("string");
  });
}
