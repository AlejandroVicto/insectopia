meta {
  name: 01 - Login y obtención de JWT
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  if (bru.getEnvName() !== "Produccion" || bru.getEnvVar("baseUrl") !== "https://insectopia.tech") {
    throw new Error("Seleccione Produccion con baseUrl=https://insectopia.tech.");
  }
  const correo = bru.getEnvVar("loginCorreo");
  const contrasena = bru.getEnvVar("loginContrasena");
  if (!correo || !contrasena) throw new Error("Configure loginCorreo y loginContrasena en los secretos de Produccion.");
  bru.deleteVar("token");
  bru.deleteVar("publicacionId");
  bru.deleteVar("publicacionPropiaId");
  bru.deleteVar("seguidoId");
  bru.deleteVar("conversacionId");
  bru.deleteVar("conversacionDemoId");
  bru.deleteVar("cuentaDemo");
  bru.deleteVar("yoNombreUsuario");
  req.setBody({ correo, contrasena });
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    if (body && typeof body.token === "string" &&
        /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(body.token)) {
      bru.setVar("token", body.token);
      if (body.user && Number.isSafeInteger(body.user.id)) bru.setVar("yoId", body.user.id);
      if (body.user && typeof body.user.nombreUsuario === "string") bru.setVar("yoNombreUsuario", body.user.nombreUsuario);
      bru.setVar("cuentaDemo", !!(body.user && /^demo\./.test(body.user.nombreUsuario || "")));
    } else {
      bru.deleteVar("token");
    }
  } else {
    bru.deleteVar("token");
  }
}

tests {
  test("Login válido devuelve HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Login devuelve un JWT de tres segmentos y un usuario", function () {
    const body = res.getBody();
    expect(body).to.have.property("token").that.is.a("string");
    expect(body.token).to.match(/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/);
    expect(body).to.have.property("user").that.is.an("object");
    expect(body.user).to.have.property("role").that.is.a("string");
  });
}
