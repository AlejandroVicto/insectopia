# Configuración de MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insectopia
DB_USER=insectopia_user
DB_PASSWORD=tu_contrasena_aqui

# Seguridad JWT
JWT_SECRET=coloca_aqui_una_clave_aleatoria_segura
JWT_EXPIRATION=86400000

# Entorno y URL pública del frontend (actividades 056/090)
# En el VPS: APP_ENVIRONMENT=production y APP_FRONTEND_BASE_URL=https://DOMINIO_REAL
APP_ENVIRONMENT=local
APP_FRONTEND_BASE_URL=http://localhost:5173

# Correo: Mailpit en local (127.0.0.1:1025); Postfix local en VPS (127.0.0.1:25)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@insectopia.invalid
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
# Sólo si el SMTP exigiera autenticación; nunca escribas valores reales aquí
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS Twilio: usar solo variables locales/secretos de entorno, no escribir credenciales aquí
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_ALLOWED_RECIPIENTS=
TWILIO_SMS_TRIAL_MODE=false
# Opcional: destinatario=remitente Trial asignado en Twilio Console; separado por comas
TWILIO_TRIAL_FROM_BY_RECIPIENT=

# Recuperación de contraseña
PASSWORD_RESET_EXPIRATION_MINUTES=15
RESET_EMAIL_MIN_INTERVAL_SECONDS=60
RESET_EMAIL_MAX_ATTEMPTS=3
RESET_EMAIL_WINDOW_MINUTES=15
RESET_IP_MAX_ATTEMPTS=30
RESET_IP_WINDOW_MINUTES=15
RESET_MAX_TRACKED_ORIGINS=10000

# Nginx: ignora X-Forwarded-For salvo que el proxy sea de confianza
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXIES=127\.0\.0\.1|::1

# Avatar persistente y URL pública del backend (HTTPS en VPS; conservar al reiniciar/desplegar)
AVATARES_UPLOAD_DIR=./uploads/avatares
APP_API_PUBLIC_URL=http://localhost:8080

# Google OAuth 2.0 / OpenID Connect
# Mantén GOOGLE_OAUTH_ENABLED=false hasta configurar credenciales reales.
# No escribas secretos reales en este archivo de ejemplo.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con la URI autorizada en Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
