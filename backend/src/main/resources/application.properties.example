spring.application.name=insectopia

# Puerto del backend
server.port=${SERVER_PORT:8080}

# Conexión MySQL
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:insectopia}
spring.datasource.username=${DB_USER}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.sql.init.mode=never

# Configuración JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

# Migraciones Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

# Seguridad JWT
app.jwt.secret=${JWT_SECRET}
app.jwt.expiration=${JWT_EXPIRATION:86400000}

# Fotografías fuera del repositorio (en producción configura una ruta absoluta)
app.storage.publicaciones.path=${PUBLICACIONES_UPLOAD_DIR:./uploads/publicaciones}
app.storage.avatares.path=${AVATARES_UPLOAD_DIR:./uploads/avatares}
app.api.public-url=${APP_API_PUBLIC_URL:http://localhost:8080}
spring.servlet.multipart.max-file-size=6MB
spring.servlet.multipart.max-request-size=6MB

# Entorno y URL pública del frontend (actividades 055/056)
app.environment=${APP_ENVIRONMENT:local}
app.frontend.base-url=${APP_FRONTEND_BASE_URL:http://localhost:5173}

# Servicio de correo: Mailpit en local, Postfix local en el VPS
spring.mail.host=${MAIL_HOST:127.0.0.1}
spring.mail.port=${MAIL_PORT:1025}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.auth=${MAIL_SMTP_AUTH:false}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_SMTP_STARTTLS:false}
spring.mail.properties.mail.smtp.starttls.required=${MAIL_SMTP_STARTTLS_REQUIRED:false}
spring.mail.properties.mail.smtp.connectiontimeout=${MAIL_SMTP_CONNECTION_TIMEOUT:5000}
spring.mail.properties.mail.smtp.timeout=${MAIL_SMTP_TIMEOUT:5000}
spring.mail.properties.mail.smtp.writetimeout=${MAIL_SMTP_WRITE_TIMEOUT:5000}
app.mail.from=${MAIL_FROM:no-reply@insectopia.invalid}

# Recuperación de contraseña
app.password-reset.expiration-minutes=${PASSWORD_RESET_EXPIRATION_MINUTES:15}
app.password-reset.rate-limit.email-min-interval-seconds=${RESET_EMAIL_MIN_INTERVAL_SECONDS:60}
app.password-reset.rate-limit.email-max-attempts=${RESET_EMAIL_MAX_ATTEMPTS:3}
app.password-reset.rate-limit.email-window-minutes=${RESET_EMAIL_WINDOW_MINUTES:15}
app.password-reset.rate-limit.ip-max-attempts=${RESET_IP_MAX_ATTEMPTS:30}
app.password-reset.rate-limit.ip-window-minutes=${RESET_IP_WINDOW_MINUTES:15}
app.password-reset.rate-limit.max-tracked-origins=${RESET_MAX_TRACKED_ORIGINS:10000}

# Nginx: las cabeceras de proxy se ignoran salvo configuración explícita
app.tomcat.trust-forwarded-headers=${TRUST_FORWARDED_HEADERS:false}
app.tomcat.trusted-proxies=${TRUSTED_PROXIES:127\\.0\\.0\\.1|::1}
